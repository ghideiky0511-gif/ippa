# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# tokens de sessão de login (runtime, não é configuração de loja) — ver
# web/src/lib/auth.ts. users.json e orderSessions.json continuam versionados
# (dado de teste), só o token de sessão em si não faz sentido commitar.
/src/data/authSessions.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
