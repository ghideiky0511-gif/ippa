APP_BIND_ADDRESS=0.0.0.0
DEV_LAN_ACCESS=true
COOKIE_SECURE=false
# URL pública do backend Socket.IO (/pedidos), acessível pelo navegador.
APP_URL=
REALTIME_URL=
# Nome comercial "de vitrine" (pode ter espaço/acento).
APP_COMERCIAL_NAME=
# Prefixo da marca usado no código de integração enviado a providers de ERP
# (ver orderPushService.buildProviderOrderIdempotencyKey) -- só
# maiúsculas/números, sem espaço/acento, porque vira parte de um
# identificador de sistema no ERP (ex.: "BIPPA1042_01").
APP_COMERCIAL_NAME_INTEGRATION=

# PostgreSQL (as senhas de exemplo servem apenas para desenvolvimento local)
POSTGRES_DB=ippa
POSTGRES_MIGRATOR_USER=ippa_migrator
POSTGRES_MIGRATOR_PASSWORD=ippa_migrator_dev_only
POSTGRES_APP_PASSWORD=ippa_app_dev_only
POSTGRES_DEV_PASSWORD=ippa_dev_local_only
POSTGRES_CONTROL_PASSWORD=ippa_control_dev_only
DATABASE_URL=postgresql://ippa_app:ippa_app_dev_only@localhost:5433/ippa
MIGRATIONS_DATABASE_URL=postgresql://ippa_migrator:ippa_migrator_dev_only@localhost:5433/ippa
CONTROL_DATABASE_URL=postgresql://ippa_control:ippa_control_dev_only@localhost:5433/ippa
# Bootstrap opcional: deixe vazio para iniciar sem tenant e sem dados fictícios.
# Para criar o primeiro tenant, preencha os quatro valores INITIAL_*. Para
# acessar /control, preencha PLATFORM_ADMIN_EMAIL e PLATFORM_ADMIN_PASSWORD.
INITIAL_TENANT_SLUG=
INITIAL_TENANT_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_NAME=
PLATFORM_ADMIN_PASSWORD=

# Recursos opcionais do backend
# Cache opcional (ver backend/src/lib/redis.ts) -- em branco desativa o cache
# sem erro, o backend cai pro Postgres. Em produção (Render) usar a Internal
# Key Value URL (redis://..., mesma região do serviço), não a externa
# (rediss://) -- ver render.yaml.
REDIS_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# Perfil dedicado à futura ferramenta de resumo operacional da última compra.
# A chave nunca é exposta ao frontend. O modelo cai em OPENAI_MODEL quando vazio.
OPENAI_API_KEY_BIPPA_CATALOG_ORDER_RESUME=
OPENAI_MODEL_BIPPA_CATALOG_ORDER_RESUME=
RESEND_API_KEY=
EMAIL_FROM=

# Cloudflare R2 — mídia do catálogo (S3 compatível)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_CATALOG_MEDIA=

# Web Push (gere as chaves uma única vez com `npx web-push generate-vapid-keys`)
# Web Push: estes valores ficam no arquivo `.env` da raiz do repositÃ³rio.
# Gere o par uma Ãºnica vez com `cd backend && npm run push:generate-keys`.
# A chave pÃºblica Ã© entregue ao navegador pela API; a privada nunca sai do backend.
PUSH_ENABLED=true
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:suporte@seudominio.com
# Protege um POST agendado para /api/{tenant}/notifications/dispatch.
# Segredo usado somente pelo backend para proteger o POST agendado de despacho.
NOTIFICATION_DISPATCH_SECRET=

# Protege POST /api/internal/catalog-sync/dispatch. Um scheduler externo pode
# chamar esta rota periodicamente; o motor decide quais tenants estão vencidos.
CATALOG_SYNC_SECRET=

# Cifra as credenciais de gateway de pagamento por tenant em repouso
# (tenant_payment_integrations.credentials_encrypted) -- 32 bytes em base64.
# Gere uma única vez com `openssl rand -base64 32` e NUNCA rotacione sem
# antes decifrar/recifrar as linhas existentes com a chave antiga.
PAYMENT_CREDENTIALS_ENCRYPTION_KEY=

# Notificação de pedido por WhatsApp (ver backend/src/services/whatsapp) --
# cada vendedora conecta o próprio número via Embedded Signup. App da Meta
# (developers.facebook.com/apps) com o produto WhatsApp habilitado.
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_API_VERSION=v21.0
# Token arbitrário que você escolhe e cola de volta no App Dashboard da Meta
# ao configurar o webhook (GET de verificação em
# app/api/internal/whatsapp/webhook/route.ts).
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Cifra o access token de WhatsApp Business por vendedora em repouso
# (seller_whatsapp_integrations.access_token_encrypted) -- 32 bytes em
# base64, mesmo procedimento de PAYMENT_CREDENTIALS_ENCRYPTION_KEY acima
# (chave própria para isolar o blast radius entre os dois domínios).
WHATSAPP_CREDENTIALS_ENCRYPTION_KEY=

# Stripe Connect (ver backend/src/payments/providers/stripe) -- contas
# Express, direct charges. Diferente de PAYMENT_CREDENTIALS_ENCRYPTION_KEY
# acima: a chave secreta aqui é da PLATAFORMA, única, não por tenant -- o
# que varia por tenant é tenant_payment_integrations.stripe_account_id
# (acct_xxx), gerado pelo onboarding (ver stripeOnboardingService.ts).
STRIPE_SECRET_KEY=
# Secret de assinatura do webhook endpoint CLÁSSICO (snapshot events v1,
# ex. payment_intent.succeeded/payment_failed) -- Stripe Dashboard >
# Developers > Webhooks > destino do tipo "Webhook endpoint" apontando pra
# /api/webhooks/stripe, formato snapshot.
STRIPE_CONNECT_WEBHOOK_SECRET=
# Secret de assinatura do Event Destination v2 (thin events, ex.
# v2.core.account.*) -- mesmo endpoint /api/webhooks/stripe, mas um
# destino separado no Dashboard (formato thin), com whsec_ próprio.
STRIPE_CONNECT_WEBHOOK_SECRET_V2=
# Comissão da plataforma em basis points (ex. 500 = 5%) aplicada via
# application_fee_amount em cada PaymentIntent. 0/ausente = sem comissão.
STRIPE_APPLICATION_FEE_BPS=
# Protege POST /api/internal/payment-reconciliation/dispatch (mesmo padrão
# de CATALOG_SYNC_SECRET acima) -- fallback de reconciliação ativa pra
# cobranças cujo webhook não chegou (ver payment_charges.next_check_at).
PAYMENT_RECONCILIATION_SECRET=
